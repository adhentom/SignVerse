# Machine-local agent, browser, and generated analysis state.
.codex/
.playwright-cli/
output/
graphify-out/
apps/chrome-extension/graphify-out/

# Security assessment working papers are not published to the public repository.
findings/
hardening/

# Source dataset videos require explicit redistribution approval. Generated,
# non-video animation clips and governed metadata remain versioned.
assets/signs/**/*.mp4
assets/signs/**/*.webm
assets/signs/*/AnimationClip.json
assets/signs/dataset-*/
assets/signs/index.json
apps/chrome-extension/public/signs/*.mp4
apps/chrome-extension/public/signs/*.webm
apps/chrome-extension/public/animations/*.json
!apps/chrome-extension/public/animations/.gitkeep

# Permission-gated dataset imports and derived vocabularies are local artifacts.
data/imports/
data/datasets/
data/landmarks/
data/normalized/
resources/datasets/*.csv
!resources/datasets/*.example.csv
apps/api/resources/lexicon/lexicon.generated.json
apps/api/resources/lexicon/unified_vocabulary.json

# Download caches and reproducible local training outputs are not release assets.
.downloads/
artifacts/
