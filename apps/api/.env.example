SIGNVERSE_ENVIRONMENT=development
SIGNVERSE_LOG_LEVEL=INFO
SIGNVERSE_CORS_ORIGINS=["chrome-extension://your-extension-id"]
SIGNVERSE_DOCS_ENABLED=true
SIGNVERSE_INTERPRETATION_PROVIDER=mock
OPENAI_API_KEY=
SIGNVERSE_OPENAI_MODEL=gpt-5.4-mini
SIGNVERSE_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
SIGNVERSE_OPENAI_TRANSCRIPTION_TIMEOUT_SECONDS=20
# Optional per-stage overrides; blank values use SIGNVERSE_OPENAI_MODEL.
# SIGNVERSE_OPENAI_SEMANTIC_MODEL=
# SIGNVERSE_OPENAI_REALIZATION_MODEL=
SIGNVERSE_OPENAI_TIMEOUT_SECONDS=8
SIGNVERSE_OPENAI_MAX_OUTPUT_TOKENS=1500
SIGNVERSE_OPENAI_SEMANTIC_CACHE_SIZE=256
SIGNVERSE_MINIMUM_SEMANTIC_CONFIDENCE=0.55
SIGNVERSE_MINIMUM_MALAYALAM_CONFIDENCE=0.55
SIGNVERSE_MINIMUM_GLOSS_CONFIDENCE=0.65
SIGNVERSE_MINIMUM_ASSET_MATCH_CONFIDENCE=0.0
